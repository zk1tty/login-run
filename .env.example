# Browserless connection
BL_PROXY=cloud_stealth_residential
BROWSERLESS_TOKEN=

# Optional server auth
ADMIN_API_KEY=

# Server
# Render injects PORT automatically. Use PUPPETEER_API_PORT only for local overrides.
PUPPETEER_API_HOST=0.0.0.0
PUPPETEER_API_PORT=8787

# Runtime artifacts
# For Render persistent disks, set this to your disk mount path, e.g. /var/data/stayauthed-runs.
RUN_LOGS_ROOT=.log

# Test identity/run target
CID=
LOGIN_URL=
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Deterministic login workflow
LOGIN_PHASE=1
OTP_DELIVERY_SELECTION=email
OTP_CODE=
OTP_CODE_FILE=/tmp/he-otp.txt
OTP_WAIT_MS=300000
OTP_MAX_ATTEMPTS=3
CHECKPOINT_PATH=
LOGIN_RECONNECT_WAIT_MS=1000
SESSION_API_TTL_MS=86400000
SESSION_API_PROCESS_KEEP_ALIVE_MS=1800000

# Gmail OTP reader
GMAIL_OAUTH_CLIENT_PATH=.auth/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_PATH=.auth/gmail-oauth-token.json
GMAIL_OTP_OUTPUT_FILE=/tmp/he-otp.txt
GMAIL_OTP_QUERY='from:updates@healthequity.com newer_than:10m'
GMAIL_OTP_WAIT_MS=300000
GMAIL_OTP_POLL_MS=5000
GMAIL_OTP_MAX_RESULTS=10
