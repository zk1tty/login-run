# Browserless connection
BL_PROXY=cloud_stealth_residential
BROWSERLESS_TOKEN=

# Optional server auth
ADMIN_API_KEY=

# Test identity/run target
CID=danny
LOGIN_URL=https://my.healthequity.com/ClientLogin.aspx
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Deterministic login workflow
LOGIN_PHASE=1
OTP_DELIVERY_SELECTION=email
OTP_CODE=
OTP_CODE_FILE=/tmp/he-otp.txt
OTP_WAIT_MS=300000
OTP_MAX_ATTEMPTS=3
CHECKPOINT_PATH=

# Gmail OTP reader
GMAIL_OAUTH_CLIENT_PATH=.auth/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_PATH=.auth/gmail-oauth-token.json
GMAIL_OTP_OUTPUT_FILE=/tmp/he-otp.txt
GMAIL_OTP_QUERY='from:updates@healthequity.com newer_than:10m'
GMAIL_OTP_WAIT_MS=300000
GMAIL_OTP_POLL_MS=5000
GMAIL_OTP_MAX_RESULTS=10
