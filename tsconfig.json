{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.ts",
    "test/**/*.js",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".log",
    "docs"
  ]
}
